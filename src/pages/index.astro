---

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#f6f7f2" />
		<title>Mona Mayhem - GitHub Contribution Battle Arena</title>
	</head>
	<body>
		<main class="arena">
			<header class="page-header">
				<p class="eyebrow">GitHub contribution showdown</p>
				<h1>Mona Mayhem</h1>
				<p class="subtitle">Who brought the most heat to the grid?</p>
			</header>

			<form id="battle-form" class="battle-form" novalidate>
				<div class="players-inputs">
					<label class="player-input">
						<span class="player-label"><span class="player-mark mark-one" aria-hidden="true">01</span>Player 1</span>
						<span class="input-wrap">
							<span aria-hidden="true">@</span>
							<input id="player-one" name="playerOne" autocomplete="off" autocapitalize="none" spellcheck="false" placeholder="octocat" required />
						</span>
					</label>
					<div class="versus" aria-hidden="true">VS</div>
					<label class="player-input">
						<span class="player-label"><span class="player-mark mark-two" aria-hidden="true">02</span>Player 2</span>
						<span class="input-wrap">
							<span aria-hidden="true">@</span>
							<input id="player-two" name="playerTwo" autocomplete="off" autocapitalize="none" spellcheck="false" placeholder="torvalds" required />
						</span>
					</label>
				</div>
				<button id="battle-button" type="submit">
					<span>Start battle</span>
					<span class="button-arrow" aria-hidden="true">↗</span>
				</button>
			</form>

			<p id="battle-status" class="status" role="status" aria-live="polite"></p>

			<section id="battle-results" class="results" aria-labelledby="results-title" hidden>
				<div class="results-heading">
					<div>
						<p class="eyebrow">The scoreboard</p>
						<h2 id="results-title">Battle results</h2>
					</div>
					<p id="battle-verdict" class="verdict"></p>
				</div>
				<div class="scoreboard">
					<article class="score-card" aria-label="Player 1 results">
						<p class="score-player"><span class="score-dot mark-one" aria-hidden="true"></span><span id="result-user-one"></span></p>
						<p class="contribution-total"><span id="result-total-one">0</span><span>contributions</span></p>
						<p class="date-range" id="result-range-one"></p>
						<div id="result-grid-one" class="contribution-grid" role="img" aria-label="Player 1 contribution graph"></div>
					</article>
					<div class="score-divider" aria-hidden="true"><span>VS</span></div>
					<article class="score-card" aria-label="Player 2 results">
						<p class="score-player"><span class="score-dot mark-two" aria-hidden="true"></span><span id="result-user-two"></span></p>
						<p class="contribution-total"><span id="result-total-two">0</span><span>contributions</span></p>
						<p class="date-range" id="result-range-two"></p>
						<div id="result-grid-two" class="contribution-grid" role="img" aria-label="Player 2 contribution graph"></div>
					</article>
				</div>
			</section>
		</main>
	</body>
</html>

<script>
	interface ContributionDay {
		weekday: number;
		count: number;
		level: number;
	}

	interface ContributionWeek {
		index: number;
		first_day: string;
		contribution_days: ContributionDay[];
	}

	interface ContributionData {
		schema: 'v2';
		total_contributions: number;
		from: string;
		to: string;
		colors_full: string[];
		weeks: ContributionWeek[];
	}

	interface ApiError {
		error?: {
			message?: string;
		};
	}

	function isContributionData(payload: unknown): payload is ContributionData {
		if (typeof payload !== 'object' || payload === null) return false;
		const data = payload as Partial<ContributionData>;
		return data.schema === 'v2' &&
			typeof data.total_contributions === 'number' &&
			typeof data.from === 'string' &&
			typeof data.to === 'string' &&
			Array.isArray(data.colors_full) &&
			Array.isArray(data.weeks) &&
			data.weeks.every((week) =>
				typeof week.first_day === 'string' &&
				Array.isArray(week.contribution_days) &&
				week.contribution_days.every((day) =>
					typeof day.weekday === 'number' &&
					typeof day.count === 'number' &&
					typeof day.level === 'number'
				)
			);
	}

	function renderContributionGrid(container: HTMLElement, username: string, data: ContributionData) {
		container.replaceChildren();
		container.setAttribute('aria-label', `${username} contribution graph: ${data.total_contributions.toLocaleString()} contributions from ${data.from} to ${data.to}`);

		for (const week of data.weeks) {
			const weekColumn = document.createElement('span');
			weekColumn.className = 'contribution-week';

			for (const day of week.contribution_days) {
				const cell = document.createElement('span');
				cell.className = 'contribution-day';
				cell.setAttribute('aria-hidden', 'true');
				cell.style.gridRow = String(day.weekday + 1);

				const date = new Date(`${week.first_day}T00:00:00Z`);
				date.setUTCDate(date.getUTCDate() + day.weekday);
				const dateLabel = date.toISOString().slice(0, 10);
				const colorIndex = Math.max(0, Math.min(data.colors_full.length - 1, Math.trunc(day.level)));
				cell.style.backgroundColor = data.colors_full[colorIndex] || '#ebedf0';
				cell.title = `${dateLabel}: ${day.count} contribution${day.count === 1 ? '' : 's'}`;

				weekColumn.append(cell);
			}

			container.append(weekColumn);
		}
	}

	const form = document.querySelector<HTMLFormElement>('#battle-form');
	const playerOneInput = document.querySelector<HTMLInputElement>('#player-one');
	const playerTwoInput = document.querySelector<HTMLInputElement>('#player-two');
	const battleButton = document.querySelector<HTMLButtonElement>('#battle-button');
	const status = document.querySelector<HTMLParagraphElement>('#battle-status');
	const results = document.querySelector<HTMLElement>('#battle-results');
	const verdict = document.querySelector<HTMLParagraphElement>('#battle-verdict');

	if (form && playerOneInput && playerTwoInput && battleButton && status && results && verdict) {
		form.addEventListener('submit', async (event) => {
			event.preventDefault();

			const usernames = [playerOneInput.value.trim(), playerTwoInput.value.trim()];
			if (usernames.some((username) => !username)) {
				status.textContent = 'Enter a GitHub username for both players to begin.';
				results.hidden = true;
				return;
			}

			status.textContent = 'Fetching contribution stats...';
			results.hidden = true;
			battleButton.disabled = true;

			try {
				const responses = await Promise.all(usernames.map(async (username) => {
					const response = await fetch(`/api/contributions/${encodeURIComponent(username)}`);
					const payload: unknown = await response.json();
					if (!response.ok) {
						const message = typeof payload === 'object' && payload !== null && 'error' in payload
							? (payload as ApiError).error?.message
							: undefined;
						throw new Error(message || `Could not load @${username}.`);
					}
					if (!isContributionData(payload)) {
						throw new Error(`Contribution data for @${username} has an unexpected format.`);
					}
					return payload;
				}));

				const [one, two] = responses;
				const userOne = usernames[0];
				const userTwo = usernames[1];
				const setText = (selector: string, value: string) => {
					const element = document.querySelector<HTMLElement>(selector);
					if (element) element.textContent = value;
				};

				setText('#result-user-one', `@${userOne}`);
				setText('#result-user-two', `@${userTwo}`);
				setText('#result-total-one', one.total_contributions.toLocaleString());
				setText('#result-total-two', two.total_contributions.toLocaleString());
				setText('#result-range-one', `${one.from} to ${one.to}`);
				setText('#result-range-two', `${two.from} to ${two.to}`);
				const gridOne = document.querySelector<HTMLElement>('#result-grid-one');
				const gridTwo = document.querySelector<HTMLElement>('#result-grid-two');
				if (gridOne) renderContributionGrid(gridOne, `@${userOne}`, one);
				if (gridTwo) renderContributionGrid(gridTwo, `@${userTwo}`, two);

				if (one.total_contributions === two.total_contributions) {
					verdict.textContent = 'It’s a draw';
				} else {
					verdict.textContent = `${one.total_contributions > two.total_contributions ? `@${userOne}` : `@${userTwo}`} wins`;
				}

				results.hidden = false;
				status.textContent = '';
			} catch (error) {
				status.textContent = error instanceof Error ? error.message : 'Something went wrong. Please try again.';
			} finally {
				battleButton.disabled = false;
			}
		});
	}
</script>

<style>
	:root {
		font-family: 'Trebuchet MS', 'Segoe UI', sans-serif;
		color: #20251f;
		background: #f6f7f2;
		font-synthesis: none;
		text-rendering: optimizeLegibility;
	}

	* {
		box-sizing: border-box;
	}

	body {
		min-width: 320px;
		min-height: 100vh;
		margin: 0;
		background-image: linear-gradient(#20251f08 1px, transparent 1px), linear-gradient(90deg, #20251f08 1px, transparent 1px);
		background-size: 32px 32px;
	}

	button,
	input {
		font: inherit;
	}

	.arena {
		width: min(100% - 40px, 780px);
		margin: 0 auto;
		padding: 72px 0 96px;
	}

	.page-header {
		margin-bottom: 42px;
		text-align: center;
	}

	.eyebrow {
		margin: 0 0 12px;
		color: #62705f;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	h1,
	h2,
	p {
		margin-top: 0;
	}

	h1 {
		margin-bottom: 8px;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(2.5rem, 3.5rem, 3.5rem);
		font-weight: 700;
	}

	.subtitle {
		margin-bottom: 0;
		color: #697064;
	}

	.battle-form {
		padding: 28px;
		border: 1px solid #dfe3d8;
		border-radius: 6px;
		background: #fff;
		box-shadow: 0 8px 24px #2832220a;
	}

	.players-inputs {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 48px minmax(0, 1fr);
		align-items: end;
		gap: 16px;
	}

	.player-input {
		display: grid;
		gap: 10px;
		min-width: 0;
		font-size: 0.9rem;
		font-weight: 700;
	}

	.player-label,
	.input-wrap {
		display: flex;
		align-items: center;
	}

	.player-label {
		gap: 9px;
	}

	.player-mark {
		display: inline-grid;
		width: 28px;
		aspect-ratio: 1;
		place-items: center;
		border-radius: 50%;
		font-size: 0.65rem;
		font-weight: 800;
	}

	.mark-one {
		color: #185e36;
		background: #b7ef96;
	}

	.mark-two {
		color: #8d3c27;
		background: #ffd2aa;
	}

	.input-wrap {
		gap: 8px;
		min-height: 48px;
		padding: 0 13px;
		border: 1px solid #cfd5c9;
		border-radius: 4px;
		color: #788073;
	}

	.input-wrap:focus-within {
		border-color: #31834a;
		outline: 3px solid #31834a26;
	}

	input {
		width: 100%;
		min-width: 0;
		border: 0;
		outline: 0;
		color: #20251f;
		background: transparent;
	}

	input::placeholder {
		color: #9da497;
	}

	.versus {
		padding-bottom: 15px;
		color: #858b7e;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 0.85rem;
		font-weight: 700;
		text-align: center;
	}

	button {
		display: flex;
		width: 100%;
		min-height: 48px;
		align-items: center;
		justify-content: center;
		gap: 10px;
		margin-top: 24px;
		border: 0;
		border-radius: 4px;
		color: #fff;
		background: #245c39;
		font-weight: 700;
		cursor: pointer;
		transition: background-color 140ms ease;
	}

	button:hover:not(:disabled) {
		background: #19482b;
	}

	button:focus-visible {
		outline: 3px solid #73bd77;
		outline-offset: 3px;
	}

	button:disabled {
		cursor: wait;
		opacity: 0.72;
	}

	.button-arrow {
		font-size: 1.1rem;
	}

	.status {
		min-height: 1.5em;
		margin: 14px 0 0;
		color: #9c3d2c;
		font-size: 0.9rem;
		text-align: center;
	}

	#battle-status:empty {
		min-height: 0;
		margin: 0;
	}

	.results {
		margin-top: 46px;
		animation: appear 220ms ease-out both;
	}

	.results[hidden] {
		display: none;
	}

	.results-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: 16px;
	}

	.results-heading .eyebrow {
		margin-bottom: 6px;
	}

	h2 {
		margin-bottom: 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 1.6rem;
	}

	.verdict {
		margin-bottom: 3px;
		color: #245c39;
		font-weight: 800;
		text-align: right;
	}

	.scoreboard {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 36px minmax(0, 1fr);
		align-items: stretch;
		gap: 12px;
	}

	.score-card {
		min-width: 0;
		padding: 20px;
		border: 1px solid #dfe3d8;
		border-radius: 5px;
		background: #fff;
	}

	.score-player {
		display: flex;
		align-items: center;
		gap: 9px;
		margin-bottom: 22px;
		font-weight: 700;
		overflow-wrap: anywhere;
	}

	.score-dot {
		width: 10px;
		aspect-ratio: 1;
		flex: 0 0 auto;
		border-radius: 50%;
	}

	.contribution-total {
		display: grid;
		gap: 3px;
		margin-bottom: 18px;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 2rem;
		font-weight: 700;
	}

	.contribution-total span + span {
		color: #73796e;
		font-family: 'Trebuchet MS', 'Segoe UI', sans-serif;
		font-size: 0.8rem;
		font-weight: 400;
	}

	.date-range {
		margin-bottom: 0;
		color: #73796e;
		font-size: 0.8rem;
	}

	.score-divider {
		display: grid;
		place-items: center;
		color: #56604f;
		font-size: 0.65rem;
		font-weight: 800;
	}

	.score-divider span {
		display: grid;
		width: 34px;
		aspect-ratio: 1;
		place-items: center;
		border: 1px solid #dfe3d8;
		border-radius: 50%;
		background: #f6f7f2;
	}

	.contribution-grid {
		display: flex;
		gap: 3px;
		min-height: 76px;
		margin-top: 16px;
		padding: 12px 0 4px;
		border-top: 1px solid #edf0e9;
		overflow-x: auto;
		overscroll-behavior-inline: contain;
		scrollbar-color: #b7c1af transparent;
		scrollbar-width: thin;
	}

	:global(.contribution-week) {
		display: grid;
		grid-template-rows: repeat(7, 8px);
		flex: 0 0 auto;
		gap: 2px;
	}

	:global(.contribution-day) {
		display: block;
		width: 8px;
		aspect-ratio: 1;
		border-radius: 2px;
		background: #ebedf0;
	}

	@keyframes appear {
		from { opacity: 0; transform: translateY(6px); }
		to { opacity: 1; transform: translateY(0); }
	}

	@media (max-width: 600px) {
		.arena {
			width: min(100% - 32px, 420px);
			padding-top: 48px;
		}

		.page-header {
			margin-bottom: 30px;
		}

		.battle-form {
			padding: 20px;
		}

		.players-inputs {
			grid-template-columns: 1fr;
			gap: 14px;
		}

		.versus {
			padding: 0;
		}

		.results-heading {
			align-items: start;
			flex-direction: column;
			gap: 8px;
		}

		.verdict {
			text-align: left;
		}

		.scoreboard {
			grid-template-columns: 1fr;
			gap: 8px;
		}

		.score-divider {
			min-height: 36px;
		}

		.score-card {
			padding: 16px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>
